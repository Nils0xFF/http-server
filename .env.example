# .env.example
PORT=8080
DB_URL="postgres://postgres:postgres@localhost:5432/chirpy?sslmode=disable"
# "dev" enables POST /admin/reset
PLATFORM="dev"
# Secret used to sign JWTs, e.g. generate with: openssl rand -base64 64
SECRET="replace-me"
# API key expected from Polka webhooks
POLKA_KEY="replace-me"